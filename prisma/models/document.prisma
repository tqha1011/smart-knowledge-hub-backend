model Document {
  id                  Int                  @id @default(autoincrement())
  publicId            String               @unique @default(uuid()) @map("public_id")
  title               String
  content             String?
  description         String?
  status              DocumentStatus       @default(Processing)
  storagePath         String               @map("storage_path")
  fileType            FileType             @map("file_type")
  fileSize            BigInt               @map("file_size")
  visibility          DocumentVisibility   @default(Public)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  knowledgeSpaceId    Int                  @map("knowledge_space_id")
  workspace           KnowledgeSpace       @relation(fields: [knowledgeSpaceId], references: [id])
  authorId            Int                  @map("author_id")
  author              User                 @relation(fields: [authorId], references: [id])
  categoryId          Int                  @map("category_id")
  category            Category             @relation(fields: [categoryId], references: [id])
  documentPermissions DocumentPermission[]
  documentChunks      DocumentChunk[]
  answerSources       AnswerSource[]

  @@unique([id, storagePath], name: "unique_document_storage_path_per_workspace")
  @@index([knowledgeSpaceId])
  @@index([authorId])
  @@map("document")
}

model DocumentPermission {
  id         Int            @id @default(autoincrement())
  documentId Int            @map("document_id")
  userId     Int            @map("user_id")
  permission PermissionType
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  document   Document       @relation(fields: [documentId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@unique([documentId, userId], name: "unique_document_permission_per_user")
  @@index([documentId])
  @@index([userId])
  @@map("document_permission")
}

model DocumentChunk {
  id               Int                         @id @default(autoincrement())
  documentId       Int                         @map("document_id")
  knowledgeSpaceId Int                         @map("knowledge_space_id")
  chunkIndex       Int                         @map("chunk_index")
  contentChunk     String                      @map("content_chunk")
  tokenCount       Int                         @map("token_count")
  embedding        Unsupported("vector(1536)")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  document         Document                    @relation(fields: [documentId], references: [id])
  knowledgeSpace   KnowledgeSpace              @relation(fields: [knowledgeSpaceId], references: [id])
  answerSources    AnswerSource[]

  @@unique([documentId, chunkIndex], name: "unique_document_chunk_per_document")
  @@index([documentId])
  @@index([knowledgeSpaceId])
  @@map("document_chunk")
}
