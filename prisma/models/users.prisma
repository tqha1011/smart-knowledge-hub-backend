model User {
  id         Int             @id @default(autoincrement())
  publicId   String          @unique @default(uuid())
  username   String
  email      String          @unique
  password   String
  role       Role            @default(Employee)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  workspaces UserWorkspace[]
  documents  Document[]

  @@map("users")
}
