model KnowledgeSpace {
  id                  Int                  @id @default(autoincrement())
  publicId            String               @unique @default(uuid()) @map("public_id")
  name                String
  description         String?
  typeId              Int                  @map("type_id")
  type                KnowledgeSpaceType   @relation(fields: [typeId], references: [id])
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  userWorkspaces      UserWorkspace[]
  documents           Document[]
  categories          Category[]
  documentChunks      DocumentChunk[]
  chatSessions        ChatSession[]
  answerSources       AnswerSource[]
  unansweredQuestions UnAnsweredQuestion[]
  faqDocumentId       Int?                  @unique @map("faq_document_id")
  faqDocument         Document?             @relation("KnowledgeSpaceFaqDocument", fields: [faqDocumentId], references: [id])

  @@map("knowledge_space")
}

model KnowledgeSpaceType {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique @default(uuid()) @map("public_id")
  name            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  knowledgeSpaces KnowledgeSpace[]

  @@index([name])
  @@map("knowledge_space_type")
}
