DATABASE_URL='postgresql://user:password@localhost:5432/mydb';
DIRECT_URL=
JWT_SECRET='your_jwt_secret_key_here'
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_SHORT_EXPIRES_IN_DAYS=1
REDIS_URL=
REDIS_PORT=

S3_API_ENDPOINT=
S3_BUCKET_NAME=
S3_API_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ACCOUNT_ID=

# API Key
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=


POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# DEFAULT PASSWORD
DEFAULT_PASSWORD=

# SMTP (notifications) — SendGrid SMTP relay; SMTP_USER is always the literal string "apikey"
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=

# Base URL of the frontend app, used to build links in emails
FRONTEND_URL=http://localhost:5173


# Cache TTL in milliseconds (default: 3 minutes)
CACHE_TTL=180000

# Load testing
LOAD_TEST_AUTH_THROTTLE_BYPASS=false
LOAD_TEST_CACHE_HEADERS=false
# Enable deterministic AI clients only in an isolated load-test environment.
LOAD_TEST_MOCK_AI=false # set true if need to load testing

# Applies to new document deletions; existing deadlines stay fixed.
DOCUMENT_TRASH_RETENTION_DAYS=30

# Public recruiter demo (opt-in). Keep real AI clients enabled.
DEMO_ENABLED=false
DEMO_KNOWLEDGE_SPACE_PUBLIC_ID=37c6da52-99f1-5465-a49c-6ec0cc721737
DEMO_SESSION_TTL_SECONDS=3600
DEMO_SESSION_QUESTION_LIMIT=20
DEMO_DAILY_QUESTION_LIMIT=200
AUTH_SELF_REGISTRATION_ENABLED=false
# Render Free cannot send SMTP: set this to false there.
EMAIL_ENABLED=true
# Exact frontend origins separated by commas; required in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Render uses a reverse proxy; set 1 there, 0 for direct local requests.
TRUST_PROXY_HOPS=0
